[Unit]
Description=Termates Cloud control plane (landing, auth, workspace proxy)
After=network-online.target nftables.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/termates/cloud.env
WorkingDirectory=/opt/termates
ExecStart=/usr/local/bin/node --disable-warning=ExperimentalWarning dist/cloud/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
